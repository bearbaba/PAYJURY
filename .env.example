# Never commit production API keys, signer keys or wallet secrets.
# PAYJURY web is read-only: it never executes payments or GenLayer writes.
PORT=4173

# Use a trusted HTTPS RPC corresponding to the network selected in the form.
# Default example for Base Sepolia; mainnet requires a separate matching RPC.
BASE_RPC_URL=https://sepolia.base.org

# Optional existing PayJury Intelligent Contract address on Studionet chain 61999.
# Do not reuse the SERVJURY contract address: it is a different ABI and use case.
GENLAYER_CONTRACT_ADDRESS=

# Quote discovery is optional, read-only and strictly host-allowlisted.
X402_QUOTE_URL=
X402_ALLOWED_HOST=

# Optional one-shot Base Sepolia payer. Keep key in a Codespaces Secret.
X402_TESTNET_PRIVATE_KEY=
X402_APPROVED_PAYEE=
# Set PAYJURY_CONFIRM_ONE_PAYMENT=I_APPROVE_ONE_TESTNET_X402_PAYMENT only after human approval.
