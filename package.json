{
  "name": "payjury",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "x402 Base USDC payment evidence and GenLayer AI delivery adjudication",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && python -m py_compile contracts/PayJury.py",
    "quote": "node scripts/inspect-x402-quote.mjs",
    "pay:testnet": "node --env-file-if-exists=.env scripts/pay-x402-testnet.mjs",
    "contract:verify": "node scripts/verify-genlayer-deployment.mjs",
    "deploy:inspect": "node scripts/inspect-deploy-tx.mjs",
    "pay:preflight": "node --env-file-if-exists=.env scripts/preflight-x402-payer.mjs",
    "case:prepare": "node --env-file-if-exists=.env scripts/prepare-first-paid-case.mjs"
  },
  "dependencies": {
    "@x402/core": "2.30.0",
    "@x402/evm": "2.30.0",
    "@x402/fetch": "2.30.0",
    "genlayer-js": "1.1.8",
    "viem": "^2.36.0"
  }
}
