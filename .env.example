# Never commit production API keys, signer keys or wallet secrets.
# PAYJURY server is read-only. Browser V2 writes require an explicit wallet approval.
PORT=4173

# Use a trusted HTTPS RPC corresponding to the network selected in the form.
# Default example for Base Sepolia; mainnet requires a separate matching RPC.
BASE_RPC_URL=https://sepolia.base.org

# Optional existing PayJury Intelligent Contract address on Studionet chain 61999.
# Do not reuse the SERVJURY contract address: it is a different ABI and use case.
# Verified PAYJURY v1 contract on Studionet 61999; read-only web lookup.\nGENLAYER_CONTRACT_ADDRESS=0xd57a04c3Cc304ab30C9435a9AE34A840802f11C8

# PAYJURY V2 was deployed on 2026-11-11; VERIFY on-chain version and rights before activating.\n# Reported deploy TX: 0x1fd845e9574e6c0956d5fd03afac8c7c70e75ea6532d4095fae3aa1276045f98\n# Reported V2 address: 0x0a6171C6a580c58d999a251436CE7c63FFc3dc31\n# Keep this blank in the example; do not enable signing without read-only checks.
# Never point this to the V1 address: V1 does not enforce payer authorization.
GENLAYER_V2_CONTRACT_ADDRESS=\n
# Quote discovery is optional, read-only and strictly host-allowlisted.
X402_QUOTE_URL=
X402_ALLOWED_HOST=

# Optional one-shot Base Sepolia payer. Keep key in a Codespaces Secret.
# Store testnet keys only as GitHub Codespaces Secrets. No value belongs here.\n# X402_TESTNET_PRIVATE_KEY= (Codespaces Secret only)
X402_APPROVED_PAYEE=
# Set PAYJURY_CONFIRM_ONE_PAYMENT=I_APPROVE_ONE_TESTNET_X402_PAYMENT only after human approval.
